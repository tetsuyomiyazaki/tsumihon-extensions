{
  "id": "nhentai",
  "name": "nHentai",
  "description": "Popular doujinshi and manga aggregator",
  "version": "1.3.0",
  "author": "Tsumihon",
  "authorUrl": null,
  "icon": "library_books",
  "category": "aggregator",
  "baseUrl": "https://nhentai.net",
  "hosts": [
    "nhentai.net",
    "nhentai.to",
    "nhentai.xxx",
    "i.nhentai.net",
    "t.nhentai.net"
  ],
  "capabilities": {
    "supportsSearch": true,
    "supportsGetById": true,
    "requiresAuth": false,
    "supportsPagination": true,
    "supportsImageSearch": false,
    "supportsIsbnScan": false,
    "requiresConfiguration": false,
    "supportsReading": false,
    "requiresCorsProxy": true
  },
  "apiConfig": {
    "type": "nhentai_api",
    "endpoints": {
      "search": "/api/search",
      "getById": "/api/gallery/{id}"
    }
  },
  "settings": {
    "type": "none"
  },
  "minAppVersion": "1.0.0",
  "appStoreSafe": true,
  "visibility": "public"
}
