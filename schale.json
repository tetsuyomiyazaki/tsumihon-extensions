{
  "id": "schale",
  "name": "Schale Network",
  "description": "Multi-mirror doujinshi archive network with automatic fallback",
  "version": "1.3.0",
  "author": "Tsumihon",
  "authorUrl": null,
  "icon": "cloud_sync",
  "category": "aggregator",
  "baseUrl": "https://schale.network",
  "hosts": [
    "schale.network",
    "anchira.to",
    "gehenna.jp",
    "niyaniya.moe",
    "shupogaki.moe",
    "hoshino.one"
  ],
  "capabilities": {
    "supportsSearch": true,
    "supportsGetById": true,
    "requiresAuth": false,
    "supportsPagination": true,
    "supportsImageSearch": false,
    "supportsIsbnScan": false,
    "requiresConfiguration": false,
    "supportsReading": false,
    "requiresCorsProxy": true
  },
  "apiConfig": {
    "type": "schale_api",
    "endpoints": {
      "search": "/api/search",
      "getById": "/api/gallery/{id}"
    },
    "fallbackUrls": [
      "https://schale.network",
      "https://anchira.to",
      "https://gehenna.jp",
      "https://niyaniya.moe",
      "https://shupogaki.moe"
    ]
  },
  "settings": {
    "type": "none"
  },
  "minAppVersion": "1.0.0",
  "appStoreSafe": true,
  "visibility": "public"
}
