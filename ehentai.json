{
  "id": "ehentai",
  "name": "E-hentai",
  "description": "Large doujinshi archive (supports ExHentai with authentication)",
  "version": "1.4.1",
  "author": "tetsuyomiyazaki",
  "authorUrl": null,
  "icon": "archive",
  "category": "aggregator",
  "baseUrl": "https://e-hentai.org",
  "hosts": [
    "e-hentai.org",
    "exhentai.org"
  ],
  "cookieHosts": [
    "e-hentai.org",
    "exhentai.org",
    "upld.e-hentai.org",
    "api.e-hentai.org",
    "forums.e-hentai.org",
    "ehgt.org"
  ],
  "capabilities": {
    "supportsSearch": true,
    "supportsGetById": true,
    "requiresAuth": false,
    "supportsPagination": true,
    "supportsImageSearch": true,
    "supportsIsbnScan": false,
    "requiresConfiguration": true,
    "supportsReading": true,
    "requiresCorsProxy": true,
    "supportsCategorySearch": true
  },
  "apiConfig": {
    "type": "ehentai_api",
    "endpoints": {
      "search": "/",
      "searchImage": "/",
      "metadata": "https://api.e-hentai.org/api.php"
    }
  },
  "settings": {
    "type": "generic",
    "fields": [
      {
        "key": "useExHentai",
        "type": "bool",
        "label": "Use ExHentai",
        "hint": "Requires authentication cookies",
        "required": false,
        "defaultValue": false
      },
      {
        "key": "ipbMemberId",
        "type": "password",
        "label": "ipb_member_id",
        "hint": "Cookie value from browser",
        "required": false
      },
      {
        "key": "ipbPassHash",
        "type": "password",
        "label": "ipb_pass_hash",
        "hint": "Cookie value from browser",
        "required": false
      },
      {
        "key": "igneousToken",
        "type": "password",
        "label": "igneous",
        "hint": "Cookie value from browser",
        "required": false
      }
    ]
  },
  "minAppVersion": "1.0.0",
  "mature": true,
  "appStoreSafe": true,
  "visibility": "public"
}
